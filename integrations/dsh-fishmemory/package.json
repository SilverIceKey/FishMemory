{
  "name": "@fishmemory/dsh-fishmemory",
  "version": "0.2.0",
  "private": true,
  "description": "DSH guidance for FishMemory MCP tools with optional, separately enabled event archiving.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./guidance": "./guidance.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "guidance.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  }
}
